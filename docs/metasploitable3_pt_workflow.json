{
  "socis_workflow_version": "1.0",
  "name": "Metasploitable3 Full Penetration Test",
  "description": "End-to-end PT workflow for Metasploitable3 (Ubuntu 14.04). Covers: full port scan, web enum, CVE/EPSS/KEV/PoC intel, SQLi (payroll_app.php), Drupalgeddon (CVE-2014-3704), vsftpd backdoor (CVE-2011-2523), UnrealIRCd (CVE-2010-2075), JWT testing, and automated reporting. Replace TARGET_IP and ATTACKER_IP before running.",
