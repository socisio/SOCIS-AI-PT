# SOCIS-AI-PT MCP Servers Configuration
# Copy this file to .env and update with your actual values

# ─── MCP Authentication ────────────────────────────────────────────────────────
# REQUIRED: Shared secret between the backend and ALL MCP servers.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=your-strong-random-token-here

# ─── Metasploit RPC Server Configuration ──────────────────────────────────────
# Local (Windows/Mac Docker Desktop):
# METASPLOIT_URL=http://host.docker.internal:55553

# Local (Linux, if Metasploit running on host):
# METASPLOIT_URL=http://localhost:55553

# Docker (if running Metasploit in Docker):
# METASPLOIT_URL=http://metasploit_framework:55553

# Remote Server:
# METASPLOIT_URL=http://192.168.1.50:55553

# Default (will fail to connect - Metasploit RPC not configured):
METASPLOIT_URL=http://localhost:55553

# Metasploit RPC password
MSF_PASSWORD=change-this-password
