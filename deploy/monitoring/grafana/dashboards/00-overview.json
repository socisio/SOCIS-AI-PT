{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "#1D9E75", "value": null } ] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Services up",
      "type": "stat",
      "targets": [ { "expr": "count(up == 1)", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0ff0fc" }, "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Requests / sec",
      "type": "stat",
      "targets": [ { "expr": "sum(rate(socis_http_requests_total[5m]))", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0ff0fc" }, "unit": "s" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "p95 request latency",
      "type": "stat",
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(socis_http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit", "thresholds": { "steps": [ { "color": "#1D9E75", "value": null }, { "color": "#E24B4A", "value": 0.01 } ] } } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "5xx error rate",
      "type": "stat",
      "targets": [ { "expr": "sum(rate(socis_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(socis_http_requests_total[5m])), 1)", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "percent" } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "CPU usage per container",
      "type": "timeseries",
      "targets": [ { "expr": "rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]) * 100", "legendFormat": "{{mode}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "bytes" } },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Memory usage",
      "type": "timeseries",
      "targets": [ { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "A" } ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["socis"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
