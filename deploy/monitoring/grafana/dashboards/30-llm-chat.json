{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "max": 20, "thresholds": { "steps": [ { "color": "#1D9E75", "value": null }, { "color": "#BA7517", "value": 16 } ] } } },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active chat sessions (of 20)",
      "type": "stat",
      "targets": [ { "expr": "socis_chat_sessions_active", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0ff0fc" }, "unit": "s" } },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "LLM p95 response time",
      "type": "stat",
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(socis_llm_request_duration_seconds_bucket[5m])) by (le))", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "steps": [ { "color": "#E24B4A", "value": null }, { "color": "#1D9E75", "value": 1 } ] }, "mappings": [ { "type": "value", "options": { "0": { "text": "unreachable" }, "1": { "text": "reachable" } } } ] } },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Ollama reachable",
      "type": "stat",
      "targets": [ { "expr": "socis_llm_provider_up{provider=\"ollama\"}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "s" } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "title": "LLM response time (p50 / p95)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(socis_llm_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(socis_llm_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "short" } },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "title": "Chat requests by provider (rate)",
      "type": "timeseries",
      "targets": [ { "expr": "sum(rate(socis_llm_requests_total[5m])) by (provider)", "legendFormat": "{{provider}}", "refId": "A" } ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["socis"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "title": "SOCIS · LLM & AI chat",
  "uid": "socis-llm",
  "version": 1
}
