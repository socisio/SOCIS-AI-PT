{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "max": 200, "thresholds": { "steps": [ { "color": "#1D9E75", "value": null }, { "color": "#BA7517", "value": 150 }, { "color": "#E24B4A", "value": 180 } ] } } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "DB connections (of 200)",
      "type": "stat",
      "targets": [ { "expr": "sum(pg_stat_activity_count)", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "steps": [ { "color": "#1D9E75", "value": null }, { "color": "#E24B4A", "value": 1 } ] } } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Deadlocks",
      "type": "stat",
      "targets": [ { "expr": "sum(rate(pg_stat_database_deadlocks[5m]))", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0ff0fc" }, "unit": "bytes" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Redis memory used",
      "type": "stat",
      "targets": [ { "expr": "redis_memory_used_bytes", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0ff0fc" }, "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Redis cache hit rate",
      "type": "stat",
      "targets": [ { "expr": "rate(redis_keyspace_hits_total[5m]) / clamp_min(rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]), 1)", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#378ADD" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "DB connections over time",
      "type": "timeseries",
      "targets": [ { "expr": "sum(pg_stat_activity_count)", "legendFormat": "connections", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#1D9E75" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Redis evictions (should stay 0)",
      "type": "timeseries",
      "targets": [ { "expr": "rate(redis_evicted_keys_total[5m])", "legendFormat": "evictions/s", "refId": "A" } ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["socis"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "title": "SOCIS · Database & cache",
  "uid": "socis-db-cache",
  "version": 1
}
