# Metasploit Framework RPC Server
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/share/metasploit-framework/bin:${PATH}"

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    gnupg \
    libpq-dev \
    libsqlite3-dev \
    locales \
    postgresql-client \
    python3 \
    python3-dev \
    python3-pip \
    ruby \
    ruby-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Metasploit Framework from GitHub (WORKDIR instead of `cd` — DS-0013)
RUN git clone --depth 1 https://github.com/rapid7/metasploit-framework.git /opt/metasploit-framework \
    && gem install bundler:2.2.16
WORKDIR /opt/metasploit-framework
RUN bundle install --without=development test

# Install MSFConsole and helpers
RUN ln -sf /opt/metasploit-framework/msfconsole /usr/local/bin/msfconsole \
    && ln -sf /opt/metasploit-framework/msfdb /usr/local/bin/msfdb \
    && ln -sf /opt/metasploit-framework/msfrpcd /usr/local/bin/msfrpcd

# Liveness: RPC port up (bash /dev/tcp idiom mirrors start.sh below; msfrpcd
# is slow to boot, hence the long start-period). Fixture stays root/:latest/
# default-creds by design — accept-risk, lab-only victim for scanner testing.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD timeout 2 bash -c "</dev/tcp/127.0.0.1/55553" || exit 1

EXPOSE 55553

# Startup script
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Waiting for PostgreSQL..."\n\
for i in {1..30}; do\n\
  if timeout 2 bash -c "</dev/tcp/postgres/5432" 2>/dev/null; then\n\
    echo "PostgreSQL is ready"\n\
    break\n\
  fi\n\
  echo "Waiting for PostgreSQL (attempt $i/30)..."\n\
  sleep 2\n\
done\n\
echo "Initializing MSF database..."\n\
msfdb init -d "postgresql://postgres:${DB_PASSWORD:-socis_secure_pass}@postgres:5432/msf" || true\n\
echo "Starting MSF RPC server..."\n\
msfrpcd -P ${MSF_PASSWORD:-metasploit_default} -S -a 0.0.0.0 -p 55553\n\
' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]
