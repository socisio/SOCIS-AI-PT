# ════════════════════════════════════════════════════════════════════
# SOCIS-AI-PT — Environment template
# Copy to deploy/docker/.env and fill in. The installers (install-dev.sh /
# install-prod.sh) generate this automatically; edit only for manual setups.
# ════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────
APP_NAME="SOCIS-AI-PT"
APP_VERSION="1.0.0"
# development | production  — production FAILS TO START with weak/insecure config
DEPLOYMENT_MODE=development
DEBUG=true
RATE_LIMIT_ENABLED=false
SECURE_COOKIES=false

# ─── Secrets (generate strong unique values) ──────────────
# SECRET_KEY / JWT_SECRET_KEY: openssl rand -hex 32
# ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin login ──────────────────────────────────────────
ADMIN_PASSWORD=

# ─── Database & Redis (passwords as variables) ────────────
DB_PASSWORD=socis_secure_pass
REDIS_PASSWORD=socis_redis_pass
DATABASE_URL=postgresql+asyncpg://socis_admin:socis_secure_pass@postgres:5432/socis_ai_pt
REDIS_URL=redis://:socis_redis_pass@redis:6379/0

# ─── CORS / URLs ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000
DOMAIN=

# ─── Ollama (EXTERNAL server — no bundled container) ──────
# Point at an external Ollama host to use it as the default LLM, or leave blank
# and configure an API provider below. Build custom socis-* models on that host
# with deploy/scripts/setup-models.sh.
OLLAMA_REMOTE_URL=
OLLAMA_REMOTE_MODEL=socis-pentest
OLLAMA_TIMEOUT=600

# ─── External LLMs (optional) ─────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── MinIO / object storage ───────────────────────────────
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=socis-minio
MINIO_SECRET_KEY=socis-minio-secret
MINIO_BUCKET=socis-reports
MINIO_SECURE=false
REPORT_RETENTION_DAYS=90

# ─── Registration / roles ─────────────────────────────────
ALLOW_OPEN_REGISTRATION=false
DEFAULT_USER_ROLE=viewer

# ─── Agentic safety / SSRF scope ──────────────────────────
SOCIS_AGENT_ALLOW_OFFENSIVE=false
MCP_ALLOW_PRIVATE_TARGETS=false
MAX_CONCURRENT_CHAT_SESSIONS=20

# ─── Metasploit ───────────────────────────────────────────
MSF_PASSWORD=
LISTENER_BIND=127.0.0.1

# ─── MCP server toggles ───────────────────────────────────
MCP_NMAP_ENABLED=true
MCP_NUCLEI_ENABLED=true
MCP_CVE_ENABLED=true
MCP_OSINT_ENABLED=true
MCP_METASPLOIT_ENABLED=false

# ─── Worker scaling ───────────────────────────────────────
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=3600

# ─── Resource limits (installer auto-sizes these per host) ─
# POSTGRES_CPUS / POSTGRES_MEM / BACKEND_CPUS / ... — see deploy/scripts/lib/autosize.sh
POSTGRES_MAX_CONNECTIONS=200

# ─── Monitoring (Prometheus + Grafana — built into compose) ─
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=   # REQUIRED: openssl rand -hex 16
GRAFANA_ANONYMOUS=false
PROM_RETENTION=15d
